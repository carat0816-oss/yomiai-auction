# Streamlit Community Cloud では、アプリの「Settings → Secrets」にこの中身を貼り付ける。
# 手元で試すときは、このファイルを .streamlit/secrets.toml という名前でコピーして値を入れる（Git には上げない）。

# 保存先のスプレッドシートのURL（サービスアカウントのメールアドレスに「編集者」で共有しておく）
sheet_url = "https://docs.google.com/spreadsheets/d/XXXXXXXXXXXXXXXXXXXX/edit"

# Google Cloud で作ったサービスアカウントの鍵（JSON）の中身を、項目ごとに書き写す
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nXXXXXXXX\n-----END PRIVATE KEY-----\n"
client_email = "sorting-collector@your-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/sorting-collector%40your-project-id.iam.gserviceaccount.com"
